<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BlackBox" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/morphly_red</item>
        <item name="colorPrimaryVariant">@color/morphly_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/morphly_red</item>
        <item name="colorSecondaryVariant">@color/morphly_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/morphly_red</item>
        <item name="colorControlActivated">@color/morphly_red</item>
        <item name="android:colorBackground">@color/morphly_bg</item>
        <item name="android:windowBackground">@color/morphly_bg</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="materialButtonStyle">@style/Morphly.Button</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/morphly_red_dark</item>
        <item name="actionMenuTextColor">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Morphly.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/morphly_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="actionMenuTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="colorPrimary">@color/morphly_red</item>
        <item name="colorAccent">@color/morphly_red</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

</resources>
