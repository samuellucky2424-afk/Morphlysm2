{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/app-version",
      "destination": "/api/config.js?route=app-version"
    },
    {
      "source": "/api/log-error",
      "destination": "/api/config.js?route=log-error"
    },
    {
      "source": "/api/payments/create",
      "destination": "/api/create-checkout.js?route=create"
    },
    {
      "source": "/api/payments/verify",
      "destination": "/api/create-checkout.js?route=verify"
    },
    {
      "source": "/api/payments/flutterwave-webhook",
      "destination": "/api/flutterwave-webhook.js"
    },
    {
      "source": "/api/public-config",
      "destination": "/api/config.js?route=public-config"
    },
    {
      "source": "/api/firebase-register",
      "destination": "/api/config.js?route=firebase-register"
    },
    {
      "source": "/api/wallet",
      "destination": "/api/config.js?route=wallet"
    },
    {
      "source": "/api/credit-packages",
      "destination": "/api/config.js?route=credit-packages"
    },
    {
      "source": "/api/login",
      "destination": "/api/auth.js?route=login"
    },
    {
      "source": "/api/signup",
      "destination": "/api/auth.js?route=signup"
    },
    {
      "source": "/api/refresh",
      "destination": "/api/auth.js?route=refresh"
    },
    {
      "source": "/api/request-password-reset",
      "destination": "/api/auth.js?route=request-password-reset"
    },
    {
      "source": "/api/update-password",
      "destination": "/api/auth.js?route=update-password"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin.js?path=:path*"
    },
    {
      "source": "/api/start-session",
      "destination": "/api/config.js?route=start-session"
    },
    {
      "source": "/api/heartbeat",
      "destination": "/api/config.js?route=heartbeat"
    },
    {
      "source": "/api/end-session",
      "destination": "/api/config.js?route=end-session"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self' https://checkout.flutterwave.com; object-src 'none'"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://morphlysm2.vercel.app"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; frame-ancestors 'none'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}